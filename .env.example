# ==============================================================================
# NEXA One Business Analytics Report — Environment Configuration Example
# ==============================================================================
# Copy this file to .env for local overrides if needed.
# By default, both local development and Vercel production run with zero-config defaults.
# DO NOT COMMIT SECRETS OR SENSITIVE CREDENTIALS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite)
# ------------------------------------------------------------------------------

# Optional: Custom API Base URL.
# If omitted or empty, the frontend uses relative same-origin requests ('/api')
# which is the recommended and default configuration for Vercel deployment.
# Required: No (Optional)
# Example: https://nexa-one-report.vercel.app or http://localhost:8000
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI / Python)
# ------------------------------------------------------------------------------

# Optional: Custom Data Directory Path
# Points to the directory containing the approved Excel workbooks.
# Defaults dynamically to the repository root where the source workbooks reside.
# Required: No (Optional)
# Example: /path/to/data
NEXA_DATA_DIR=

# Optional: Server Port (for standalone python3 backend/app/main.py serve)
# Defaults to 8000
# Required: No (Optional)
PORT=8000
